generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}


enum Role { 
  USER 
  ADMIN 
} 
model User { 
  id    Int    @id @default(autoincrement()) 
  firstName String
  lastName  String 
  email String @unique 
  role  Role   @default(USER) 

  orders Order[]
  carts Cart[]
}

model Books {
  id          Int      @id @default(autoincrement())
  title       String
  author      String
  publishedAt DateTime
}


model Category { 
  id    Int    @id @default(autoincrement()) 
  name  String
  tags Tags[]
  @@map("categories")
}

model Tags{
  id    Int    @id @default(autoincrement()) 
  name  String 
  category Category @relation(fields: [categoryId], references: [id])
  categoryId Int
  @@map("tags")
}

model Order { 
  id    Int    @id @default(autoincrement()) 
  user  User   @relation(fields: [userId], references: [id]) 
  userId Int
  total Float
}

model Cart { 
  id    Int    @id @default(autoincrement()) 
  user  User   @relation(fields: [userId], references: [id]) 
  userId Int
  total Float
}