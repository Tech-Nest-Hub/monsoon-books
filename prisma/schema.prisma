generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ───── ENUMS ─────

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING    // just placed
  CONFIRMED  // admin confirmed
  DELIVERED  // physically delivered
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  KHALTI
  ESEWA
}

// ───── USER ─────

model User {
  id        Int     @id @default(autoincrement())
  authId    String  @unique       // Supabase auth user ID
  firstName String
  lastName  String
  email     String  @unique
  role      Role    @default(USER)
  provider  String?               // "google", "facebook", or "email"

  cart      Cart?                 // one cart per user
  orders    Order[]
  wishlists Wishlist[]

  @@map("users")
}

// ───── BOOK ─────

model Book {
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  coverImage    String            // Cloudinary URL
  author        String
  language      String   @default("Nepali")
  price         Float
  stock         Int      @default(0)
  publisher     String?
  publishedYear Int?

  categoryId    Int
  category      Category @relation(fields: [categoryId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt



  images      BookImage[] 
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlists     Wishlist[]

  @@map("books")
}

model BookImage {
  id        Int      @id @default(autoincrement())
  url       String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId    Int
  order     Int      @default(0)  // for sorting thumbnails

  @@map("book_images")
}
// ───── CATEGORY ─────

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique             // "Fiction", "Loksewa", "Academic", etc.
  books Book[]

  @@map("categories")
}

// ───── CART ─────

model Cart {
  id        Int        @id @default(autoincrement())
  user      User       @relation(fields: [userId], references: [id])
  userId    Int        @unique     // one cart per user
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id         Int   @id @default(autoincrement())
  cart       Cart  @relation(fields: [cartId], references: [id])
  cartId     Int
  book       Book  @relation(fields: [bookId], references: [id])
  bookId     Int
  quantity   Int   @default(1)
  priceAtAdd Float // snapshot of Book.price when added to cart

  @@unique([cartId, bookId]) // same book can't appear twice; update quantity instead
  @@map("cart_items")
}

// ───── ORDER ─────

model Order {
  id              Int           @id @default(autoincrement())
  user            User          @relation(fields: [userId], references: [id])
  userId          Int
  items           OrderItem[]
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod @default(CASH_ON_DELIVERY)
  total           Float

  // delivery info
  deliveryAddress String
  phone           String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

model OrderItem {
  id         Int   @id @default(autoincrement())
  order      Order @relation(fields: [orderId], references: [id])
  orderId    Int
  book       Book  @relation(fields: [bookId], references: [id])
  bookId     Int
  quantity   Int
  priceAtBuy Float // snapshot of Book.price when order was placed

  @@map("order_items")
}

// ───── WISHLIST ─────

model Wishlist {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  book      Book     @relation(fields: [bookId], references: [id])
  bookId    Int
  createdAt DateTime @default(now())

  @@unique([userId, bookId]) // can't wishlist the same book twice
  @@map("wishlists")
}