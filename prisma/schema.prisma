generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ───── ENUMS ─────

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING      // just placed
  CONFIRMED    // admin confirmed
  PROCESSING   // payment confirmed, processing
  SHIPPED      // shipped to customer
  DELIVERED    // physically delivered
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  KHALTI
  ESEWA
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum BookStatus {
  AVAILABLE
  OUT_OF_STOCK
  DISCONTINUED
}

// ───── USER ─────
model User {
  id        Int     @id @default(autoincrement())
  authId    String  @unique
  firstName String
  lastName  String
  email     String  @unique
  image     String?
  role      Role    @default(USER)
  status    UserStatus @default(ACTIVE) // Add this field
  provider  String?
  
  cart      Cart?
  orders    Order[]
  shippingAddresses ShippingAddress[]
  wishlists Wishlist[]
  reviews   Review[]
  reviewLikes ReviewLike[]
  payments  Payment[]

  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

// ───── BOOK ─────

model Book {
  id            Int        @id @default(autoincrement())
  title         String
  description   String
  coverImage    String     // Cloudinary URL
  author        String
  language      String     @default("Nepali")
  price         Float
  originalPrice Float?      // for discounts; null if no discount
  stock         Int        @default(0)
  publisher     String?
  edition       String?
  status        BookStatus @default(AVAILABLE)
  isActive      Boolean    @default(true) // for soft deletes
  isTrending    Boolean    @default(false) // for highlighting trending books
  isFeatured     Boolean    @default(false) // for homepage featured section

  categoryId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review      Review[]
  images      BookImage[]
  category    Category      @relation(fields: [categoryId], references: [id])
  cartItems   CartItem[]
  orderItems  OrderItem[]
  wishlists   Wishlist[]

  @@map("books")
}

model BookImage {
  id     Int    @id @default(autoincrement())
  url    String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId Int
  order  Int    @default(0) // for sorting thumbnails

  @@map("book_images")
}

// ───── CATEGORY ─────

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique // "Fiction", "Loksewa", "Academic", etc.
  image String? @default("")// optional category image URL
  books Book[]

  @@map("categories")
}

// ───── CART ─────

model Cart {
  id        Int        @id @default(autoincrement())
  user      User       @relation(fields: [userId], references: [id])
  userId    Int        @unique // one cart per user
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id         Int   @id @default(autoincrement())
  cart       Cart  @relation(fields: [cartId], references: [id])
  cartId     Int
  book       Book  @relation(fields: [bookId], references: [id])
  bookId     Int
  quantity   Int   @default(1)
  priceAtAdd Float // snapshot of Book.price when added to cart

  @@unique([cartId, bookId]) // same book can't appear twice; update quantity instead
  @@map("cart_items")
}

// ───── PAYMENT ─────

model Payment {
  id              String        @id @default(cuid())
  transactionUuid String        @unique
  transactionId   String?
  amount          Float
  productId       String
  productName     String
  userId          Int           // Changed from String to Int to match User.id
  user            User          @relation(fields: [userId], references: [id])
  status          PaymentStatus @default(PENDING)
  paymentMethod   PaymentMethod?
  createdAt       DateTime      @default(now())
  completedAt     DateTime?
  
  order   Order?   // Optional: link to order
  orderId Int?     // Optional: link to order
  
  @@index([transactionUuid])
  @@index([userId])
  @@index([status])
  @@map("payments")
}

// ───── ORDER (Fixed) ─────

model Order {
  id              Int           @id @default(autoincrement())
  orderNumber     String        @unique // Human readable order number (e.g., "ORD-20241201-001")
  user            User          @relation(fields: [userId], references: [id])
  userId          Int
  items           OrderItem[]
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod @default(CASH_ON_DELIVERY)
  paymentStatus   PaymentStatus @default(PENDING)
  total           Float
  subtotal        Float
  tax             Float         @default(0)
  shippingCost    Float         @default(0)
  discount        Float         @default(0)

  // delivery info
  deliveryAddress String
  phone           String
  email           String?
  notes           String?       // Order notes or special instructions

  // Payment relationship
  payment        Payment?      @relation(fields: [paymentId], references: [id])
  paymentId      String?       @unique // One order has one payment
  
  // Tracking
  trackingNumber String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  cancelledAt    DateTime?
  cancelReason   String?

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id         Int   @id @default(autoincrement())
  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    Int
  book       Book  @relation(fields: [bookId], references: [id])
  bookId     Int
  quantity   Int
  priceAtBuy Float // snapshot of Book.price when order was placed
  
  @@map("order_items")
}

// ───── WISHLIST ─────

model Wishlist {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  book      Book     @relation(fields: [bookId], references: [id])
  bookId    Int
  createdAt DateTime @default(now())

  @@unique([userId, bookId]) // can't wishlist the same book twice
  @@map("wishlists")
}

// ───── REVIEW ─────

model Review {
  id      Int     @id @default(autoincrement())
  rating  Int     // 1-5
  comment String? // optional written review

  user   User @relation(fields: [userId], references: [id])
  userId Int
  book   Book @relation(fields: [bookId], references: [id])
  bookId Int
  likes ReviewLike[]

  createdAt DateTime @default(now())

  @@unique([userId, bookId]) // one review per user per book
  @@map("reviews")
}

model ReviewLike {
  id       Int  @id @default(autoincrement())
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId Int
  user     User   @relation(fields: [userId], references: [id])
  userId   Int
  isLike   Boolean  // true = 👍, false = 👎

  @@unique([userId, reviewId])  // one vote per user per review
  @@map("review_likes")
}

model NewsletterSubscriber {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  createdAt  DateTime @default(now())
}

model ShippingAddress {
  id         Int      @id @default(autoincrement())
  fullName   String
  street     String
  city       String
  district   String
  postalCode String?
  phone      String
  label      String   // "HOME" or "OFFICE"
  isDefault  Boolean  @default(false)

  user       User     @relation(fields: [userId], references: [id])
  userId     Int

  createdAt  DateTime @default(now())

  @@map("shipping_addresses")
}